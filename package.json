{
  "name": "dsh-token-anxiety",
  "version": "0.1.0",
  "description": "Token Anxiety widget for DeepSeek Harness: live per-task cost tracking over the session projection — peak/valley pricing, sortable cost table, currency manager (COP/USD/CNY + add/remove), click-to-explain, i18n",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "harness",
    "plugin",
    "bundle",
    "token",
    "cost",
    "pricing",
    "currency",
    "dsh"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
